# Initial bootstrap password (used only when no owner account exists yet; >= 12 chars)
MAX_ADMIN_PASSWORD=

# Storage paths
MAX_DATA_DIR=./data
MAX_VAULT_DIR=./vault
MAX_VAULT_REMOTE=

# HTTP bind address and external origin (for Origin / CSRF validation)
MAX_LISTEN=127.0.0.1:8787
MAX_PUBLIC_URL=http://127.0.0.1:8787

# Timezone for schedules, daily usage, and run timestamps
MAX_TZ=Asia/Ho_Chi_Minh

# Engine configuration (Phase 1 primary engine: agy)
MAX_ENGINE_AUTH=subscription
MAX_ENGINES=agy
MAX_SLOTS_AGY=3

# Quota governor (leave token caps empty for automatic learning mode)
MAX_QUOTA_SHORT_HOURS=5
MAX_QUOTA_SHORT_TOKENS=
MAX_QUOTA_WEEK_TOKENS=
MAX_QUOTA_BACKGROUND_SHARE=0.7

# Browser pool & optional integrations (Phase 3+)
MAX_BROWSER_SEATS=1
MAX_BROWSER_LOCALE=en-US
MAX_BROWSER_TZ=
CLOAKBROWSER_LICENSE_KEY=
AGENTMEMORY_SECRET=
MAX_TELEGRAM_BOT_TOKEN=
MAX_TELEGRAM_OWNER_IDS=
MAX_QUIET_HOURS=
