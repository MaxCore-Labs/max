{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"exclude": ["src/service-worker", "scripts", "src/lib/ui/tokens.test.ts"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}
