	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@types/dompurify": "3.0.5",
		"jsdom": "^26.1.0",
		"openapi-typescript": "^7.6.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.1.0",
		"tailwindcss": "^4.0.0",
